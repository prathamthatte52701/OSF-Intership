PORT=4000
VITE_AUTH_MODE=api
VITE_UI_PREVIEW=false
# Required. MongoDB connection string (URL-encode special characters in the password). Placeholder only: put the real value in .env.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER_HOST
# Optional database name; defaults to the one in the URI, else "test".
# MONGODB_DB=osf
APP_ORIGIN=http://localhost:3000
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=OSF Admin
OTP_HMAC_SECRET=
