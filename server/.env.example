# Placeholders only. Copy to .env and fill in real values locally; never commit .env.
PORT=4000
# Required. MongoDB connection string (URL-encode special characters in the password). Placeholder only: put the real value in .env.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER_HOST
# Optional database name; defaults to the one in the URI, else "test".
# MONGODB_DB=osf
APP_ORIGIN=http://localhost:3000
OTP_HMAC_SECRET=replace-with-a-random-value-of-at-least-32-characters
EMAIL_USER=
EMAIL_APP_PASSWORD=

# TRUST_PROXY: number of reverse-proxy hops in front of the API (e.g. 1 behind one load balancer/nginx).
# Leave unset in local development. When set, req.ip comes from X-Forwarded-For so rate limits are
# per real client instead of one shared bucket for everyone behind the proxy. Do not set it if the API
# is directly internet-facing (clients could spoof X-Forwarded-For).
# TRUST_PROXY=1
